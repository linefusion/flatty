{
  "name": "@linefusion/flatty",
  "version": "0.0.13",
  "license": "MIT",
  "publish": {
    "exclude": [
      ".vscode",
      "build",
      "scripts",
      "examples"
    ]
  },
  "exports": "./mod.ts",
  "lock": false,
  "lint": {
    "rules": {
      "tags": [
        "jsr",
        "recommended"
      ],
      "exclude": [
        "no-explicit-any",
        "no-slow-types"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "fmt": {
    "useTabs": false,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "tasks": {
    "build": "deno run -A ./scripts/build.ts",
    "deploy": "deno run -A ./scripts/deploy.ts",
    "dev": {
      "dependencies": [
        "dev:test",
        "dev:run"
      ]
    },
    "dev:test": "deno test -A --watch",
    "dev:run": {
      "command": "cd $INIT_CWD/examples/protocol && deno run -A --watch --config ../../deno.json ../../mod.ts"
    },
    "install": "deno install -A -g --force --config ./deno.json mod.ts",
    "generate": "deno run -A --watch scripts/generate.ts"
  },
  "imports": {
    "@linefusion/flatty": "./mod.ts",
    "@linefusion/flatty/": "./",
    "@linefusion/logger": "jsr:@linefusion/logger@0.0.3",
    "@linefusion/strings": "jsr:@linefusion/strings@0.0.2",
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/async": "jsr:@std/async@1.0.15",
    "@std/bytes": "jsr:@std/bytes@1.0.6",
    "@std/cache": "jsr:@std/cache@0.2.1",
    "@std/cbor": "jsr:@std/cbor@0.1.9",
    "@std/cli": "jsr:@std/cli@1.0.24",
    "@std/collections": "jsr:@std/collections@1.1.3",
    "@std/crypto": "jsr:@std/crypto@1.0.5",
    "@std/csv": "jsr:@std/csv@1.0.6",
    "@std/data-structures": "jsr:@std/data-structures@1.0.9",
    "@std/datetime": "jsr:@std/datetime@0.225.5",
    "@std/dotenv": "jsr:@std/dotenv@0.225.5",
    "@std/encoding": "jsr:@std/encoding@1.0.10",
    "@std/expect": "jsr:@std/expect@1.0.17",
    "@std/fmt": "jsr:@std/fmt@1.0.8",
    "@std/fmt/bytes": "jsr:@std/fmt@1.0.8/bytes",
    "@std/fmt/colors": "jsr:@std/fmt@1.0.8/colors",
    "@std/fmt/duration": "jsr:@std/fmt@1.0.8/duration",
    "@std/fmt/printf": "jsr:@std/fmt@1.0.8/printf",
    "@std/front-matter": "jsr:@std/front-matter@1.0.9",
    "@std/fs": "jsr:@std/fs@1.0.20",
    "@std/html": "jsr:@std/html@1.0.5",
    "@std/http": "jsr:@std/http@1.0.22",
    "@std/ini": "jsr:@std/ini@1.0.0-rc.8",
    "@std/internal": "jsr:@std/internal@1.0.12",
    "@std/io": "jsr:@std/io@0.225.2",
    "@std/json": "jsr:@std/json@1.0.2",
    "@std/jsonc": "jsr:@std/jsonc@1.0.2",
    "@std/log": "jsr:@std/log@0.224.14",
    "@std/media-types": "jsr:@std/media-types@1.1.0",
    "@std/msgpack": "jsr:@std/msgpack@1.0.3",
    "@std/net": "jsr:@std/net@1.0.6",
    "@std/path": "jsr:@std/path@1.1.3",
    "@std/random": "jsr:@std/random@0.1.4",
    "@std/regexp": "jsr:@std/regexp@1.0.1",
    "@std/semver": "jsr:@std/semver@1.0.7",
    "@std/streams": "jsr:@std/streams@1.0.14",
    "@std/tar": "jsr:@std/tar@0.1.9",
    "@std/testing": "jsr:@std/testing@1.0.16",
    "@std/text": "jsr:@std/text@1.0.16",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "@std/ulid": "jsr:@std/ulid@1.0.0",
    "@std/uuid": "jsr:@std/uuid@1.0.9",
    "@std/webgpu": "jsr:@std/webgpu@0.224.9",
    "@std/yaml": "jsr:@std/yaml@1.0.10",
    "@types/handlebars": "npm:@types/handlebars@4.1.0",
    "@types/mustache": "npm:@types/mustache@4.2.6",
    "@types/nunjucks": "npm:@types/nunjucks@3.2.6",
    "@types/react": "npm:@types/react@19.2.7",
    "@types/react-dom": "npm:@types/react-dom@19.2.3",
    "@types/underscore": "npm:@types/underscore@1.13.0",
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.8",
    "@cspotcode/outdent": "jsr:@cspotcode/outdent@0.8.0",
    "@david/dax": "jsr:@david/dax@0.44.1",
    "@quentinadam/zip": "jsr:@quentinadam/zip@0.1.8",
    "@eta-dev/eta": "jsr:@eta-dev/eta@3.5.0",
    "@swc/wasm": "npm:@swc/wasm@1.15.3",
    "@vento/vento": "jsr:@vento/vento@1.14.0",
    "flatbuffers": "npm:flatbuffers@25.9.23",
    "flatbuffers_reflection": "npm:flatbuffers_reflection@1.3.0",
    "liquidjs": "npm:liquidjs@10.24.0",
    "meriyah": "npm:meriyah@7.0.0",
    "mustache": "npm:mustache@4.2.0",
    "nunjucks": "npm:nunjucks@3.2.4",
    "react": "npm:react@19.2.1",
    "react-dom": "npm:react-dom@19.2.1",
    "ts-pattern": "npm:ts-pattern@5.9.0",
    "tslib": "npm:tslib@2.8.1",
    "tsxt": "npm:tsxt@0.0.4",
    "underscore": "npm:underscore@1.13.7",
    "handlebars": "npm:handlebars@4.7.8",
    "zod": "npm:zod@4.1.13",
    "esbuild": "npm:esbuild@0.27.1",
    "esbuild_deno_loader": "jsr:@luca/esbuild-deno-loader@0.11.1"
  }
}
